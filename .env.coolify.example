# Public endpoint
TAIGA_SCHEME=https
TAIGA_DOMAIN=taiga.example.com
SUBPATH=
WEBSOCKETS_SCHEME=wss

# Container images. Replace latest with immutable digests copied from the
# currently running production containers before promoting staging.
TAIGA_BACK_IMAGE=taigaio/taiga-back:latest
TAIGA_EVENTS_IMAGE=taigaio/taiga-events:latest
TAIGA_PROTECTED_IMAGE=taigaio/taiga-protected:latest

# Secrets: define real values in Coolify, never commit them.
SECRET_KEY=
POSTGRES_USER=taiga
POSTGRES_PASSWORD=
RABBITMQ_USER=taiga
RABBITMQ_PASS=
RABBITMQ_VHOST=taiga
RABBITMQ_ERLANG_COOKIE=

# Email
EMAIL_BACKEND=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_DEFAULT_FROM=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

ATTACHMENTS_MAX_AGE=360
ENABLE_TELEMETRY=False
